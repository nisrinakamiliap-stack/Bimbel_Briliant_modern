erDiagram

    %% ─── USERS & PROFILES ───────────────────────────────────────────────────
    users {
        bigint      id              PK
        string      name
        string      email           UK
        string      password
        enum        role            "admin|guru|murid"
        boolean     is_active
        timestamp   email_verified_at
        string      remember_token
        timestamps  created_at_updated_at
    }

    student_profiles {
        bigint      id              PK
        bigint      user_id         FK
        string      nis             UK "nullable"
        string      phone
        date        birth_date      "nullable"
        string      address         "nullable"
        string      school          "nullable"
        string      grade_level     "nullable"
        string      parent_name     "nullable"
        string      parent_phone    "nullable"
        timestamps  created_at_updated_at
    }

    teacher_profiles {
        bigint      id              PK
        bigint      user_id         FK
        string      nip             UK "nullable"
        string      phone
        string      subject_expertise "nullable"
        text        bio             "nullable"
        timestamps  created_at_updated_at
    }

    %% ─── PROGRAMS & CLASSES ──────────────────────────────────────────────────
    programs {
        bigint      id              PK
        string      name
        enum        category        "akademik|non_akademik|bahasa|lainnya"
        enum        level           "SD|SMP|SMA|Umum"
        text        description     "nullable"
        decimal     price           "10,2"
        integer     duration_months
        boolean     is_active
        boolean     is_public
        timestamps  created_at_updated_at
    }

    classes {
        bigint      id              PK
        bigint      program_id      FK
        bigint      teacher_id      FK "user_id guru"
        string      name
        integer     capacity
        enum        mode            "online|offline|hybrid"
        enum        status          "active|inactive|full"
        timestamps  created_at_updated_at
    }

    %% ─── SCHEDULES ───────────────────────────────────────────────────────────
    schedules {
        bigint      id              PK
        bigint      class_id        FK
        enum        day_of_week     "Senin|Selasa|Rabu|Kamis|Jumat|Sabtu|Minggu"
        time        start_time
        time        end_time
        string      room            "nullable"
        enum        status          "active|cancelled"
        timestamps  created_at_updated_at
    }

    %% ─── ENROLLMENTS ─────────────────────────────────────────────────────────
    enrollments {
        bigint      id              PK
        bigint      student_id      FK "user_id murid"
        bigint      class_id        FK
        enum        status          "pending_payment|waiting_verification|approved|rejected|cancelled"
        date        enrolled_at     "nullable"
        timestamps  created_at_updated_at
    }

    %% ─── PAYMENTS ────────────────────────────────────────────────────────────
    payments {
        bigint      id              PK
        bigint      enrollment_id   FK
        decimal     amount          "10,2"
        enum        status          "pending|waiting_verification|paid|rejected|refunded"
        string      payment_method  "nullable"
        string      proof_file      "nullable"
        text        rejection_note  "nullable"
        bigint      verified_by     FK "user_id admin nullable"
        timestamp   verified_at     "nullable"
        timestamps  created_at_updated_at
    }

    %% ─── MATERIALS ───────────────────────────────────────────────────────────
    materials {
        bigint      id              PK
        bigint      class_id        FK
        bigint      teacher_id      FK "user_id guru"
        string      title
        text        description     "nullable"
        string      file_path       "nullable"
        string      external_url    "nullable"
        enum        status          "draft|published"
        timestamps  created_at_updated_at
    }

    %% ─── ASSIGNMENTS & SUBMISSIONS ───────────────────────────────────────────
    assignments {
        bigint      id              PK
        bigint      class_id        FK
        bigint      teacher_id      FK "user_id guru"
        string      title
        text        instructions
        string      attachment_path "nullable"
        timestamp   due_at
        timestamps  created_at_updated_at
    }

    submissions {
        bigint      id              PK
        bigint      assignment_id   FK
        bigint      student_id      FK "user_id murid"
        string      file_path       "nullable"
        text        notes           "nullable"
        timestamp   submitted_at
        enum        status          "submitted|late|graded"
        timestamps  created_at_updated_at
    }

    assignment_grades {
        bigint      id              PK
        bigint      submission_id   FK UK
        bigint      teacher_id      FK "user_id guru"
        decimal     score           "5,2"
        text        feedback        "nullable"
        timestamp   graded_at
        timestamps  created_at_updated_at
    }

    %% ─── STUDENT ATTENDANCES ─────────────────────────────────────────────────
    attendances {
        bigint      id              PK
        bigint      schedule_id     FK
        bigint      student_id      FK "user_id murid"
        enum        status          "hadir|izin|sakit|alpa"
        text        notes           "nullable"
        date        attendance_date
        timestamps  created_at_updated_at
    }

    %% ─── TUTOR ATTENDANCES ───────────────────────────────────────────────────
    tutor_attendances {
        bigint      id              PK
        bigint      teacher_id      FK "user_id guru"
        bigint      schedule_id     FK
        timestamp   check_in_at     "nullable"
        timestamp   check_out_at    "nullable"
        enum        status          "on_time|late|incomplete|completed"
        text        notes           "nullable"
        date        session_date
        timestamps  created_at_updated_at
    }

    %% ─── NOTIFICATIONS ───────────────────────────────────────────────────────
    notifications {
        bigint      id              PK
        bigint      user_id         FK
        string      title
        text        body
        string      type            "nullable"
        boolean     is_read
        timestamp   read_at         "nullable"
        timestamps  created_at_updated_at
    }

    %% ─── CHATS & MESSAGES ────────────────────────────────────────────────────
    chats {
        bigint      id              PK
        bigint      student_id      FK "user_id murid"
        bigint      teacher_id      FK "user_id guru"
        timestamp   last_message_at "nullable"
        timestamps  created_at_updated_at
    }

    messages {
        bigint      id              PK
        bigint      chat_id         FK
        bigint      sender_id       FK "user_id pengirim"
        text        body
        boolean     is_read
        timestamp   read_at         "nullable"
        timestamps  created_at_updated_at
    }

    %% ─── RELATIONS ───────────────────────────────────────────────────────────
    users            ||--o|  student_profiles    : "has one"
    users            ||--o|  teacher_profiles    : "has one"

    programs         ||--o{  classes             : "has many"

    users            ||--o{  classes             : "teaches"
    classes          ||--o{  schedules           : "has many"
    classes          ||--o{  enrollments         : "has many"
    classes          ||--o{  materials           : "has many"
    classes          ||--o{  assignments         : "has many"

    users            ||--o{  enrollments         : "enrolls"
    enrollments      ||--o{  payments            : "has many"
    users            ||--o{  payments            : "verified by"

    users            ||--o{  materials           : "created by"
    users            ||--o{  assignments         : "created by"

    assignments      ||--o{  submissions         : "has many"
    users            ||--o{  submissions         : "submitted by"
    submissions      ||--||  assignment_grades   : "has one"
    users            ||--o{  assignment_grades   : "graded by"

    schedules        ||--o{  attendances         : "has many"
    users            ||--o{  attendances         : "student"

    schedules        ||--o{  tutor_attendances   : "has many"
    users            ||--o{  tutor_attendances   : "tutor"

    users            ||--o{  notifications       : "has many"

    users            ||--o{  chats               : "student side"
    users            ||--o{  chats               : "teacher side"
    chats            ||--o{  messages            : "has many"
    users            ||--o{  messages            : "sends"
